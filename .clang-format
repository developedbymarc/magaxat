# .clang-format
BasedOnStyle: LLVM

# Opening bracket on the same line as the statement
BreakBeforeBraces: Attach

# 4-space indentation, spaces not tabs
IndentWidth: 4
TabWidth: 4
UseTab: Never
SpacesBeforeTrailingComments: 2

# Always indent the contents of a namespace
NamespaceIndentation: All

# Indent public/private/protected labels inside a class one level in
# from the class brace, and indent members another level past that
AccessModifierOffset: -4
IndentAccessModifiers: false

# Indent "case" labels under "switch", and indent the code inside
# each case block one further level
IndentCaseLabels: true
# IndentCaseBlocks: true

ColumnLimit: 100

# Group includes by category
IncludeBlocks: Regroup
IncludeCategories:
  # C system headers, e.g. <stdio.h>
  - Regex:           '^<.*\.h>'
    Priority:        1
  # Project headers, e.g. <magaxat/foo.h>
  - Regex:           '^<magaxat/.*>'
    Priority:        4
  # C++ system headers, e.g. <vector>
  - Regex:           '^<.*>'
    Priority:        2
  # Everything else (project/local headers, "quoted" includes)
  - Regex:           '.*'
    Priority:        3
